import datetime, time, requests, os, threading

API_KEY = os.environ.get("API_KEY", "مفتاح")
API_PASSWORD = os.environ.get("API_PASSWORD", "مرور")
BASE_URL = "https://trading-api-fpractice.capital.com/api/v2/"
ACCOUNTS_FILE = "sub_accounts.txt"

class CapitalComConnector:
    def __init__(self, label):
        self.label = label

    def authenticate(self):
        print("OK " + self.label)
        return True

    def get_market_data(self):
        return {"price": 4620.0, "rsi": 45}

    def place_order(self, symbol, direction, size, sl, tp):
        print("ORDER " + self.label + " " + direction + " " + symbol)

class SingleBot:
    def __init__(self, label):
        self.label = label
        self.connector = CapitalComConnector(label)
        self.balance = 10000.0
        self.position = None

    def run(self):
        print("START " + self.label)
        self.connector.authenticate()
        while True:
            data = self.connector.get_market_data()
            price = data["price"]
            rsi = data["rsi"]

            print(self.label + " Price " + str(price) + " RSI " + str(rsi))
            if rsi < 30 and self.position is None:
                self.connector.place_order("XAUUSD", "BUY", 0.1, price - 5, price + 10)
                self.position = {"price": price, "size": 0.1}
            elif rsi > 70 and self.position is not None:
                pnl = (price - self.position["price"]) * self.position["size"]
                self.balance += pnl
                self.connector.place_order("XAUUSD", "SELL", 0.1, price + 5, price - 10)
                print("PnL " + self.label + " " + str(pnl))
                self.position = None
            time.sleep(5)

if __name__ == "__main__":
    accounts = ["Master"]
    if os.path.exists(ACCOUNTS_FILE):
        with open(ACCOUNTS_FILE, "r") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    if line not in accounts:
                        accounts.append(line)
    print("ACCOUNTS " + str(len(accounts)))
    threads = []
    for acc in accounts:
        bot = SingleBot(acc)
        t = threading.Thread(target=bot.run)
        t.start()
        threads.append(t)
    try:
        for t in threads:
            t.join()
    except KeyboardInterrupt:
        print("\nتم إيقاف المصنع بأمان.")
